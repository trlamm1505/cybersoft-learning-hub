        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{demo6Username}}\",\n  \"password\": \"{{demo6Password}}\",\n  \"fullName\": \"{{demo6FullName}}\",\n  \"email\": \"{{demo6Email}}\",\n  \"address\": \"{{demo6Address}}\",\n  \"status\": \"{{demo6Status}}\",\n  \"phone\": \"{{demo6Phone}}\",\n  \"gender\": \"{{demo6Gender}}\",\n  \"dateOfBirth\": \"{{demo6DateOfBirth}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
