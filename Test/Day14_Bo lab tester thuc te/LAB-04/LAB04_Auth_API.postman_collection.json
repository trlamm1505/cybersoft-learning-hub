          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{demo6Api}}/Auth/login",
          "host": [
            "{{demo6Api}}"
          ],
          "path": [
            "Auth",
            "login"
          ]
