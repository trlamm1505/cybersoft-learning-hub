{
  "extends": "./tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "uploads", "mock-data-service", "jest.setup-env.ts", "**/*spec.ts"],
  // `nest start --watch`: chỉ theo dõi mã nguồn. Bỏ qua thư mục sinh ra khi chạy (dist, uploads ảnh bằng chứng Tester Lab),
  // file tsbuildinfo và spec để typecheck/jest/audit không làm backend tự khởi động lại giữa lúc đang kiểm thử hay chấm bài.
  "watchOptions": {
    // Polling theo mtime: Windows/IDE hay chạm file mà không đổi nội dung (nest báo "File change detected" rồi restart 15 giây làm FE
    // văng ERR_CONNECTION_REFUSED). Với polling, chỉ file thật sự đổi mới kích hoạt biên dịch lại.
    "watchFile": "priorityPollingInterval",
    "watchDirectory": "fixedPollingInterval",
    "fallbackPolling": "dynamicPriority",
    "excludeDirectories": ["**/node_modules", "dist", "uploads", "docs", "reports"],
    "excludeFiles": ["**/*.tsbuildinfo", "**/*.spec.ts", "**/*.log"]
  }
}
