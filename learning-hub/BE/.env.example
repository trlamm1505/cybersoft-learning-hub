# =====================================================================================================================
# CyberSoft Learning Hub — cấu hình backend (MỘT file duy nhất cho cả dự án).
# `npm run setup` tự tạo BE/.env từ file này (sinh sẵn JWT_SECRET, CONFIG_ENCRYPTION_KEY). KHÔNG commit BE/.env.
# Frontend không cần .env (mặc định gọi http://localhost:3000/api).
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# 1. Server & CORS
# ---------------------------------------------------------------------------------------------------------------------
# Cổng backend (API ở http://localhost:<PORT>/api).
PORT=3000
# Địa chỉ web mà người dùng mở (dùng cho CORS và link trong email đặt lại mật khẩu).
FRONTEND_URL="http://localhost:5173"
# Thêm origin FE khác được gọi API kèm cookie, phân cách dấu phẩy. Để trống: FRONTEND_URL + localhost:5173/4173.
CORS_ORIGINS=

# ---------------------------------------------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ---------------------------------------------------------------------------------------------------------------------
# Máy local: cài MongoDB Community (https://www.mongodb.com/try/download/community) rồi giữ nguyên dòng dưới.
# MongoDB Atlas: Atlas → Connect → Drivers, dán chuỗi dạng
#   mongodb+srv://<user>:<mat-khau>@<cluster>.mongodb.net/cybersoft-learning-hub?retryWrites=true&w=majority
# (mật khẩu có ký tự đặc biệt phải mã hóa %XX; Atlas → Network Access phải cho phép IP của bạn). Kiểm tra: npm run check:mongo
DATABASE_URL="mongodb://localhost:27017/cybersoft"

# ---------------------------------------------------------------------------------------------------------------------
# 3. Auth, JWT & tài khoản mẫu
# ---------------------------------------------------------------------------------------------------------------------
# Khóa ký đăng nhập: chuỗi ngẫu nhiên ≥ 32 byte, mỗi máy/môi trường một chuỗi (setup tự sinh). Bắt buộc ở production.
# Tự sinh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Mật khẩu của các tài khoản mẫu do `npm run seed` tạo (admin@gmail.com, teacher@gmail.com, lop6-9@gmail.com...).
DEFAULT_SEED_PASSWORD="123456"
# Gửi email đặt lại mật khẩu bằng Gmail: bật Xác minh 2 bước rồi tạo App Password tại
# https://myaccount.google.com/apppasswords (16 ký tự). Để trống = tắt gửi email.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Chỉ dev, khi CHƯA cấu hình Gmail: true = trả liên kết đặt lại mật khẩu trong phản hồi API để thử luồng.
DEV_MAIL_MOCK=

# ---------------------------------------------------------------------------------------------------------------------
# 4. AI (Google Gemini) — AI Coach, AI Tạo Đề, chấm Insight / AI Lab
# ---------------------------------------------------------------------------------------------------------------------
# Lấy key miễn phí tại https://aistudio.google.com/app/apikey (Create API key). Để trống = AI dùng chế độ dự phòng.
# Admin cũng có thể nhập key trong Admin Portal → Cấu hình (được mã hóa bằng CONFIG_ENCRYPTION_KEY khi lưu).
GEMINI_API_KEY=
# Khóa mã hóa cấu hình bí mật (AES-256-GCM, 64 ký tự hex; setup tự sinh). Đổi khóa thì key Gemini đã lưu không giải mã được.
# Tự sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# 5. Code Runner (chạy bài Python của học viên — 100% local, không Docker)
# ---------------------------------------------------------------------------------------------------------------------
# Cần Python 3.10+ trên máy. Để trống: tự tìm (Windows: %LOCALAPPDATA%\Python\bin\python.exe rồi `python`; macOS/Linux: python3).
# Đặt đường dẫn đầy đủ nếu máy có nhiều bản Python, vd C:/Python312/python.exe hoặc /usr/bin/python3.
PYTHON_BIN=
# Số bài chạy đồng thời và số bài chờ tối đa (bảo vệ máy chủ khi nhiều học viên nộp cùng lúc).
CODE_RUNNER_MAX_CONCURRENCY=
CODE_RUNNER_MAX_QUEUE=

# ---------------------------------------------------------------------------------------------------------------------
# 6. Tùy chọn nâng cao: dữ liệu DA Lab / AI Lab (để trống cả mục này là chạy được ngay)
# ---------------------------------------------------------------------------------------------------------------------
# Data Lab chạy SQL: sqlite (mặc định, chạy sẵn trong backend) | postgres (cần Postgres bạn tự cài + SANDBOX_DB_*).
SQL_ENGINE="sqlite"
# Nguồn dữ liệu Lab (Dataset Registry của nhóm Data & AI). Để TRỐNG = dữ liệu tích hợp sẵn trong backend.
DATA_SERVICE_BASE_URL=
DATA_SERVICE_API_KEY=
# Chỉ khi SQL_ENGINE=postgres: Postgres chứa CSDL sales_v1 và tài khoản chỉ đọc lab_reader.
SANDBOX_DB_HOST=
SANDBOX_DB_PORT=
LAB_READER_PASSWORD=
