# Cấu hình backend. `npm run setup` (thư mục learning-hub) tự tạo BE/.env từ file này
# và sinh JWT_SECRET ngẫu nhiên. Không commit file .env (đã được .gitignore chặn).

# MongoDB. Máy mới không có MongoDB: setup/dev tự bật container `mongo-dev` (docker compose).
DATABASE_URL="mongodb://localhost:27017/cybersoft"
# Dùng MongoDB Atlas thay cho local: thay bằng chuỗi của bạn (mật khẩu có ký tự đặc biệt phải mã hóa %XX), vd
#   DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cybersoft?retryWrites=true&w=majority"
# Atlas → Network Access phải cho phép IP của bạn (hoặc 0.0.0.0/0 cho dev/Vercel). Kiểm tra: `npm run check:mongo`.
# Backend chỉ cần DATABASE_URL (MONGODB_URI/MONGO_URI chỉ là phương án dự phòng, không cần đặt thêm).
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Khóa ký đăng nhập. Mỗi máy/môi trường một chuỗi riêng (setup tự sinh).
JWT_SECRET=

# --- Tùy chọn: thiếu thì tính năng tương ứng tạm tắt, phần còn lại vẫn chạy ---
# AI Coach, sinh đề, chấm Insight/AI Lab bằng Gemini. Xin khóa của chính bạn hoặc xin nhóm qua kênh riêng (không dán lên chat chung).
GEMINI_API_KEY=
# Gửi email đặt lại mật khẩu (Gmail + App Password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Nguồn dữ liệu DA Lab / AI Lab (Dataset Registry của Data & AI Resource - TTS 01).
# Để TRỐNG = dùng dữ liệu tích hợp sẵn trong backend. Đặt http://localhost:8000 để dùng server thật của TTS 01,
# rồi chạy `npm run ingest:sandbox` (thư mục learning-hub) để nạp dữ liệu từ API vào Postgres Sandbox.
# Khóa dev của server TTS 01 (vai trò student, chỉ đọc): cybersoft-student-public-key-101
DATA_SERVICE_BASE_URL=
DATA_SERVICE_API_KEY=

# Chạy bài Python của học viên: docker (mặc định, cô lập) | local (dev nhanh, cần python3 trên máy)
PYTHON_SANDBOX="docker"
PYTHON_SANDBOX_IMAGE="python:3.12-slim"

# Data Lab (SQL): sqlite (mặc định) chạy SQLite in-memory ngay trong Node, không cần Docker/Postgres, chạy được trên Vercel/serverless;
# postgres dùng lại Postgres Sandbox do TTS 01 cấp.
SQL_ENGINE="sqlite"

# Khóa mã hóa cấu hình bí mật (AES-256-GCM). Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=
