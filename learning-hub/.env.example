# Cấu hình dùng chung cho learning-hub (một nguồn duy nhất).
# Sao chép thành .env rồi đổi giá trị. Docker Compose tự đọc file .env ở thư mục
# này; mock data-service cũng đọc nó để dựng sandbox_db_url, nên đổi mật khẩu
# ở đây là cả role lab_reader lẫn chuỗi kết nối đổi theo.

# Tài khoản chỉ đọc mà Learning Hub dùng để chạy SQL của học viên.
LAB_READER_PASSWORD=lab_reader_pw

# Chủ sở hữu DB sandbox (superuser trong container). Bắt buộc đổi trên production.
SANDBOX_DB_OWNER=sandbox_owner
SANDBOX_DB_OWNER_PASSWORD=sandbox_owner_pw

# Cổng sandbox trên máy local (chỉ bind 127.0.0.1).
SANDBOX_DB_PORT=55432

# Tùy chọn: ghi đè toàn bộ chuỗi kết nối mà mock cấp (sandbox ở máy khác).
# MOCK_SANDBOX_DB_URL=postgresql://lab_reader:<mat-khau>@host:5432/sales_v1
