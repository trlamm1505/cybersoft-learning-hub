# Cấu hình dùng chung cho learning-hub (một nguồn duy nhất).
# Sao chép thành .env rồi đổi giá trị. Docker Compose tự đọc file .env ở thư mục
# này; mock data-service cũng đọc nó để dựng sandbox_db_url, nên đổi mật khẩu
# ở đây là cả role lab_reader lẫn chuỗi kết nối đổi theo.

# Tài khoản chỉ đọc mà Learning Hub dùng để chạy SQL của học viên.
LAB_READER_PASSWORD=lab_reader_pw

# Chủ sở hữu DB sandbox (superuser trong container). Bắt buộc đổi trên production.
SANDBOX_DB_OWNER=sandbox_owner
SANDBOX_DB_OWNER_PASSWORD=sandbox_owner_pw

# Cổng sandbox trên máy local (chỉ bind 127.0.0.1).
SANDBOX_DB_PORT=55432

# Tùy chọn: ghi đè toàn bộ chuỗi kết nối mà mock cấp (sandbox ở máy khác).
# MOCK_SANDBOX_DB_URL=postgresql://lab_reader:<mat-khau>@host:5432/sales_v1

# ---------------------------------------------------------------------------
# Nguồn dữ liệu cho DA Lab / AI Lab (Dataset Registry của Data & AI Resource, TTS 01)
# ---------------------------------------------------------------------------
# Để TRỐNG (mặc định): dùng dữ liệu tích hợp sẵn trong backend, không cần bật thêm
# server nào. Đặt địa chỉ server thật của TTS 01 để chuyển sang dữ liệu thật, vd
# http://localhost:8000 (server đó phải có hợp đồng v1.1: data_dictionary,
# sandbox_db_url, evaluation-sets).
DATA_SERVICE_BASE_URL=
DATA_SERVICE_API_KEY=
# Chỉ dùng khi dev với server thật: máy chủ TTS 01 không trả lời thì tạm dùng dữ
# liệu tích hợp sẵn (ghi cảnh báo). Production nên để trống để lỗi hiện ra rõ ràng.
# DATA_SERVICE_FALLBACK=embedded

# ---------------------------------------------------------------------------
# Chỉ cho `docker compose --profile full up` (chạy trọn bộ để deploy)
# ---------------------------------------------------------------------------
# Bắt buộc đặt khi chạy full: chuỗi ngẫu nhiên dài, không dùng lại giữa các môi trường.
JWT_SECRET=
GEMINI_API_KEY=
# Cổng web (nginx) trên máy chủ.
WEB_PORT=8080
# Địa chỉ web mà người dùng truy cập (dùng cho CORS/link email).
FRONTEND_URL=http://localhost:8080

