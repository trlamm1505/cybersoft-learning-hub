        </mxCell>
        <mxCell id="c3_item4" value="&lt;b&gt;Candidate Pool Pruning&lt;/b&gt;&lt;br&gt;&lt;font color='#94A3B8'&gt;Top-15 Candidates extraction&lt;br&gt;Feeding second-stage Reranker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;fontColor=#A855F7;fontSize=11.5;" vertex="1" parent="col3_box">
