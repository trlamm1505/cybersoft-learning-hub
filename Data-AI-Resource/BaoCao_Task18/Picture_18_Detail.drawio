        <!-- Column 3: Hybrid Fusion -->
        <mxCell id="col3_box" value="3. HYBRID FUSION &amp; FILTER&#xa;Multi-Branch Rank Merging" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#A855F7;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;startSize=50;rounded=1;arcSize=4;" vertex="1" parent="1">
