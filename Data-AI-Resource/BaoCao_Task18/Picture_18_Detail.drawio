        <mxCell id="c3_item1" value="&lt;b&gt;Reciprocal Rank Fusion (RRF)&lt;/b&gt;&lt;br&gt;&lt;font color='#94A3B8'&gt;RRF(d) = Σ w_m / (k + rank_m(d))&lt;br&gt;Default: k=60, w_dense=0.5, w_bm25=0.5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#A855F7;strokeWidth=1.8;fontColor=#A855F7;fontSize=11.5;" vertex="1" parent="col3_box">
          <mxGeometry x="15" y="65" width="260" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c3_item2" value="&lt;b&gt;Weighted Score Normalization&lt;/b&gt;&lt;br&gt;&lt;font color='#94A3B8'&gt;Score = α*Dense_norm + (1-α)*BM25_norm&lt;br&gt;Min-Max Linear Feature Rescaling&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#A855F7;fontSize=11.5;" vertex="1" parent="col3_box">
