{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersoft.edu.vn/schemas/project.schema.json",
  "title": "CyberSoftStudentProjectManifest",
  "description": "JSON Schema chuẩn hóa cấu trúc dự án học viên và dự án mẫu thuộc CyberSoft Project Bank.",
  "type": "object",
  "required": [
    "$schema",
    "metadata",
    "business_context",
    "datasets",
    "requirements",
    "kpis",
    "rubrics",
    "hints",
    "expected_artifacts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "domain",
        "level",
        "target_role",
        "estimated_hours",
        "version",
        "author",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "domain": {
          "type": "string",
          "enum": [
            "retail_ecommerce",
            "hr_operations",
            "finance_banking",
            "nlp_genai",
            "computer_vision",
            "recommender_system",
            "edtech_analytics"
          ]
        },
        "level": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "target_role": {
          "type": "string",
          "enum": [
            "data_analyst",
            "ai_engineer",
            "data_engineer",
            "qa_engineer"
          ]
        },
        "estimated_hours": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "author": {
          "type": "string"
        },
        "created_date": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "business_context": {
      "type": "object",
      "required": [
        "company_name",
        "industry",
        "problem_statement",
        "business_objectives",
        "target_stakeholders"
      ],
      "properties": {
        "company_name": { "type": "string" },
        "industry": { "type": "string" },
        "problem_statement": { "type": "string", "minLength": 20 },
        "business_objectives": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "target_stakeholders": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "name",
          "file_path",
          "format",
          "description",
          "record_count",
          "columns"
        ],
        "properties": {
          "dataset_id": { "type": "string" },
          "name": { "type": "string" },
          "file_path": { "type": "string" },
          "format": {
            "type": "string",
            "enum": ["csv", "json", "parquet", "sqlite"]
          },
          "description": { "type": "string" },
          "record_count": { "type": "integer", "minimum": 1 },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "description"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "description": { "type": "string" },
                "primary_key": { "type": "boolean" },
                "foreign_key": { "type": "string" }
              }
            }
          },
          "known_data_issues": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "total_core_points",
        "total_extension_points",
        "core_tasks",
        "extension_tasks"
      ],
      "properties": {
        "total_core_points": {
          "type": "integer",
          "minimum": 50,
          "maximum": 80
        },
        "total_extension_points": {
          "type": "integer",
          "minimum": 20,
          "maximum": 50
        },
        "core_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task_item"
          }
        },
        "extension_tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task_item"
          }
        }
      }
    },
    "kpis": {
      "type": "object",
      "required": ["business_kpis", "technical_kpis"],
      "properties": {
        "business_kpis": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/kpi_item" }
        },
        "technical_kpis": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/kpi_item" }
        }
      }
    },
    "rubrics": {
      "type": "object",
      "required": ["total_points", "categories"],
      "properties": {
        "total_points": {
          "type": "integer",
          "const": 100
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["category_id", "name", "weight", "criteria"],
            "properties": {
              "category_id": { "type": "string" },
              "name": { "type": "string" },
              "weight": { "type": "number", "minimum": 1, "maximum": 100 },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "criterion_id",
                    "name",
                    "max_points",
                    "quantitative_metric",
                    "scoring_levels"
                  ],
                  "properties": {
                    "criterion_id": { "type": "string" },
                    "name": { "type": "string" },
                    "max_points": { "type": "number", "minimum": 1 },
                    "quantitative_metric": { "type": "string", "minLength": 10 },
                    "scoring_levels": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "required": ["level", "points", "descriptor"],
                        "properties": {
                          "level": {
                            "type": "string",
                            "enum": ["exemplary", "proficient", "developing", "unsatisfactory"]
                          },
                          "points": { "type": "number", "minimum": 0 },
                          "descriptor": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["tier", "tier_name", "task_hints"],
        "properties": {
          "tier": { "type": "integer", "enum": [1, 2, 3] },
          "tier_name": { "type": "string" },
          "task_hints": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "name",
          "type",
          "file_pattern",
          "required",
          "description"
        ],
        "properties": {
          "artifact_id": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["code", "sql", "notebook", "report", "dashboard", "dataset"]
          },
          "file_pattern": { "type": "string" },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "task_item": {
      "type": "object",
      "required": [
        "task_id",
        "name",
        "description",
        "points",
        "learning_outcomes",
        "expected_outputs"
      ],
      "properties": {
        "task_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "points": { "type": "integer", "minimum": 1 },
        "learning_outcomes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "expected_outputs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "kpi_item": {
      "type": "object",
      "required": [
        "kpi_id",
        "name",
        "formula",
        "unit",
        "tolerance_pct"
      ],
      "properties": {
        "kpi_id": { "type": "string" },
        "name": { "type": "string" },
        "formula": { "type": "string" },
        "expected_value": { "type": ["number", "string", "null"] },
        "unit": { "type": "string" },
        "tolerance_pct": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    }
  }
}
