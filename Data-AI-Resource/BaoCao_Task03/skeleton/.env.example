# ==============================================================================
# CYBERSOFT DATA & AI LAB — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Quy tắc bảo mật: File này chỉ chứa cấu hình mẫu, TUYỆT ĐỐI KHÔNG commit secret thật!
# ==============================================================================

# 1. APPLICATION SETTINGS
APP_NAME=CyberSoft-Data-AI-Lab
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=127.0.0.1

# 2. STORAGE & DATABASE PATHS (Local-First, Zero-Config)
DATABASE_URL=sqlite:///./cybersoft_lab.db
CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data

# 3. AI / EMBEDDING CONFIGURATION (CPU-First Standard)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SIMILARITY_THRESHOLD=0.65

# 4. QUALITY GATE THRESHOLDS
MIN_QUALITY_SCORE=85.0
MAX_DUPLICATE_RATIO=0.02
MAX_MISSING_RATIO=0.05
ENABLE_PII_DETECTION=True

# 5. SECURITY & LIMITS
SECRET_KEY=change-this-in-production-use-a-strong-random-secret
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=120
